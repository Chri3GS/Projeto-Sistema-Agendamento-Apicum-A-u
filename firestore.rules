rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validUserProfile(uid) {
      return signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.nome is string
        && request.resource.data.fotoURL is string
        && request.resource.data.tipo in ['Aluno', 'Professor']
        && request.resource.data.keys().hasAll([
          'uid', 'nome', 'email', 'fotoURL', 'tipo', 'atualizadoEm'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'nome', 'email', 'fotoURL', 'tipo', 'criadoEm', 'atualizadoEm'
        ]);
    }

    match /usuarios/{uid} {
      allow read: if signedInAs(uid);
      allow create: if validUserProfile(uid)
        && request.resource.data.keys().hasAll(['criadoEm']);
      allow update: if validUserProfile(uid)
        && resource.data.uid == uid;
      allow delete: if false;
    }

    match /ambientes/{ambienteId} {
      allow read: if true;
      allow write: if false;
    }

    match /reservas/{reservaId} {
      allow read: if true;
      allow write: if false;
    }

    match /agendaLocks/{lockId} {
      allow read, write: if false;
    }

    match /adminAuditoria/{auditId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
